    def analyze_news_sentiment(self, news_data):
        """
        Analiza sentiment nouvèl yo ak detekte impact
        """
        sentiment_scores = {}
        impact_keywords = {
            'bullish': ['adoption', 'investment', 'etf', 'institutional', 'surge', 'growth', 'bull', 'rally'],
            'bearish': ['crash', 'ban', 'regulation', 'hack', 'drop', 'bear', 'decline', 'fall'],
            'high_impact': ['bitcoin', 'ethereum', 'fed', 'sec', 'treasury', 'blackrock', 'elon', 'musk']
        }
        
        for article in news_data:
            text = f"{article['title']} {article['description']}"
            
            # Sentiment analysis
            blob = TextBlob(text)
            sentiment = blob.sentiment.polarity
            
            # Impact score
            impact = 0
            text_lower = text.lower()
            
            for keyword in impact_keywords['high_impact']:
                if keyword in text_lower:
                    impact += 2
            
            for keyword in impact_keywords['bullish']:
                if keyword in text_lower:
                    sentiment += 0.2
                    impact += 1
            
            for keyword in impact_keywords['bearish']:
                if keyword in text_lower:
                    sentiment -= 0.2
                    impact += 1
            
            # Store sentiment ak impact
            for symbol in self.symbols:
                coin = symbol.split('/')[0].lower()
                if coin in text_lower:
                    if coin not in sentiment_scores:
                        sentiment_scores[coin] = {'sentiment': 0, 'impact': 0, 'count': 0}
                    
                    sentiment_scores[coin]['sentiment'] += sentiment
                    sentiment_scores[coin]['impact'] += impact
                    sentiment_scores[coin]['count'] += 1
        
        # Calculate averages
        for coin in sentiment_scores:
            if sentiment_scores[coin]['count'] > 0:
                sentiment_scores[coin]['sentiment'] /= sentiment_scores[coin]['count']
                sentiment_scores[coin]['impact'] /= sentiment_scores[coin]['count']
        
        return sentiment_scores
    
    def get_market_data(self, symbol):
        """
        Jwenn done mache yo
        """
        try:
            ticker = self.exchange.fetch_ticker(symbol)
            ohlcv = self.exchange.fetch_ohlcv(symbol, '1m', limit=100)
            
            # Calculate technical indicators
            df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
            df['sma_20'] = df['close'].rolling(window=20).mean()
            df['sma_50'] = df['close'].rolling(window=50).mean()
            df['rsi'] = self.calculate_rsi(df['close'])
            
            current_price = ticker['last']
            sma_20 = df['sma_20'].iloc[-1]
            sma_50 = df['sma_50'].iloc[-1]
            rsi = df['rsi'].iloc[-1]
            
            return {
                'price': current_price,
                'sma_20': sma_20,
                'sma_50': sma_50,
                'rsi': rsi,
                'volume': ticker['quoteVolume'],
                'change_24h': ticker['percentage']
            }
            
        except Exception as e:
            print(f"❌ Error getting market data for {symbol}: {e}")
            return None
    
    def calculate_rsi(self, prices, period=14):
        """
        Calculate RSI
        """
        delta = prices.diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
        rs = gain / loss
        rsi = 100 - (100 / (1 + rs))
        return rsi
    
    def should_buy(self, symbol, market_data, sentiment_data):
        """
        Detèmine si nou dwe achte
        """
        coin = symbol.split('/')[0].lower()
        
        # Technical signals
        tech_score = 0
        
        # Price above SMA signals
        if market_data['price'] > market_data['sma_20']:
            tech_score += 1
        if market_data['sma_20'] > market_data['sma_50']:
            tech_score += 1
        
        # RSI signals
        if 30 <= market_data['rsi'] <= 70:
            tech_score += 1
        elif market_data['rsi'] < 30:
            tech_score += 2  # Oversold
        
        # Volume check
        if market_data['volume'] > 1000000:  # High volume
            tech_score += 1
        
        # Sentiment signals
        sentiment_score = 0
        if coin in sentiment_data:
            if sentiment_data[coin]['sentiment'] > 0.1:
                sentiment_score += 2
            if sentiment_data[coin]['impact'] > 1:
                sentiment_score += 1
        
        # Final decision
        total_score = tech_score + sentiment_score
        return total_score >= 4
    
    def should_sell(self, symbol, entry_price, current_price):
        """
        Detèmine si nou dwe vann
        """
        profit_pct = (current_price - entry_price) / entry_price
        
        # Take profit
        if profit_pct >= self.profit_target:
            return True, "PROFIT"
        
        # Stop loss
        if profit_pct <= -self.stop_loss:
            return True, "STOP_LOSS"
        
        return False, "HOLD"
    
    def execute_trade(self, symbol, side, amount):
        """
        Egzekite kòmès yo
        """
        try:
            if side == 'buy':
                order = self.exchange.create_market_buy_order(symbol, amount)
            else:
                order = self.exchange.create_market_sell_order(symbol, amount)
            
            print(f"✅ Trade executed: {side} {amount} {symbol}")
            print(f"📄 Order ID: {order['id']}")
            return order
            
        except Exception as e:
            print(f"❌ Error executing trade: {e}")
            return None
    
