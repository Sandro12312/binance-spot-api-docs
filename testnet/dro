    def run_bot(self):
        """
        Fonksyon prensipal bot la
        """
        print("🚀 Bot Trading ak News Analysis ap kòmanse...")
        self.display_status()
        
        while True:
            try:
                print(f"\n⏰ Analysis cycle at {datetime.now().strftime('%H:%M:%S')}")
                
                # Get news
                news = self.get_crypto_news(hours=1)
                print(f"📰 {len(news)} articles analyzed")
                
                # Analyze sentiment
                sentiment = self.analyze_news_sentiment(news)
                if sentiment:
                    print(f"💭 Sentiment: {sentiment}")
                
                # Check each symbol
                for symbol in self.symbols:
                    market_data = self.get_market_data(symbol)
                    if not market_data:
                        continue
                    
                    coin = symbol.split('/')[0].lower()
                    
                    # Check existing positions
                    if symbol in self.positions:
                        # Check if should sell
                        should_sell, reason = self.should_sell(
                            symbol, 
                            self.positions[symbol]['entry_price'],
                            market_data['price']
                        )
                        
                        if should_sell:
                            # Execute sell order
                            order = self.execute_trade(symbol, 'sell', self.positions[symbol]['amount'])
                            if order:
                                profit = (market_data['price'] - self.positions[symbol]['entry_price']) * self.positions[symbol]['amount']
                                print(f"✅ {symbol} sold - {reason} - Profit: {profit:.2f} USDT")
                                del self.positions[symbol]
                    
                    else:
                        # Check if should buy
                        if len(self.positions) < self.max_positions:
                            if self.should_buy(symbol, market_data, sentiment):
                                # Calculate position size
                                try:
                                    balance = self.exchange.fetch_balance()
                                    usdt_balance = balance['USDT']['free']
                                    amount = (usdt_balance * self.position_size) / market_data['price']
                                    
                                    if amount > 0:
                                        order = self.execute_trade(symbol, 'buy', amount)
                                        if order:
                                            self.positions[symbol] = {
                                                'entry_price': market_data['price'],
                                                'amount': amount,
                                                'timestamp': datetime.now()
                                            }
                                            print(f"🟢 {symbol} bought at {market_data['price']:.2f}")
                                except Exception as e:
                                    print(f"❌ Error calculating position size: {e}")
                
                # Display current status every 10 cycles
                if len(self.last_analysis) % 10 == 0:
                    self.display_status()
                
                # Wait before next analysis
                print(f"⏳ Next analysis in {self.analysis_interval} seconds...")
                time.sleep(self.analysis_interval)
                
            except KeyboardInterrupt:
                print("\n⛔ Bot stopped by user")
                self.display_status()
                break
            except Exception as e:
                print(f"❌ Error in main loop: {e}")
                time.sleep(30)

